# Racine web de Suiv'Formation
# Annule le « Require all denied » du .htaccess de la racine du projet.
Require all granted
Options -Indexes

# HTTPS obligatoire
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Fichiers cachés interdits
RewriteRule (^|/)\. - [F,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Les pages HTML ne sont jamais mises en cache (les fichiers assets/ ont un nom versionné)
<FilesMatch "\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>
